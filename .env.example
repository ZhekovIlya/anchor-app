# Anchor — Telegram bot + progress sync. Copy to .env.local for local dev
# (scripts/dev-api.js reads it) and set the same names in Vercel → Settings →
# Environment Variables. Never commit real values.

# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_BOT_USERNAME=YourAnchorBot
# Any long random string; passed to setWebhook(secret_token) by scripts/telegram-setup.js
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string
# Comma-separated Telegram user ids allowed to use the bot and sync (the bot tells you yours)
ALLOWED_TELEGRAM_IDS=111111111

# Public origin of the app (used for links in bot messages and the webhook URL)
PUBLIC_APP_URL=https://your-app.vercel.app

# Upstash Redis (Vercel Marketplace sets the KV_* names automatically).
# Leave empty locally to use the in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel sends `Authorization: Bearer $CRON_SECRET` to /api/cron-nudge
CRON_SECRET=replace-with-another-long-random-string

# 🔊 provider (server/tts.js)
TTS_PROVIDER=google-translate

# Port of scripts/dev-api.js (Vite proxies /api there)
# DEV_API_PORT=3001
